{
  "name": "truck-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write resources/js resources/css vite.config.ts",
    "format:check": "prettier --check resources/js resources/css vite.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/barlow-semi-condensed": "^5.2.0",
    "@inertiajs/react": "^3.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
