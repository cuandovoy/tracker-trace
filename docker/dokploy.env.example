# Pegar en Environment de la aplicación y reemplazar todos los REEMPLAZAR.
# Variables de ejecución: no son Build Arguments ni un archivo para subir al repositorio con secretos.
APP_NAME="Consola de flota"
APP_ENV=production
APP_DEBUG=false
APP_KEY=REEMPLAZAR_CLAVE_BASE64
APP_URL=https://REEMPLAZAR_DOMINIO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
DB_CONNECTION=mysql
DB_HOST=REEMPLAZAR_HOST_INTERNO_MYSQL
DB_PORT=3306
DB_DATABASE=truck_tracker
DB_USERNAME=truck_tracker
DB_PASSWORD=REEMPLAZAR_PASSWORD_MYSQL
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=REEMPLAZAR_HOST_SMTP
MAIL_PORT=587
MAIL_USERNAME=REEMPLAZAR_USUARIO_SMTP
MAIL_PASSWORD=REEMPLAZAR_PASSWORD_SMTP
MAIL_FROM_ADDRESS=REEMPLAZAR_REMITENTE
MAIL_FROM_NAME="Consola de flota"
